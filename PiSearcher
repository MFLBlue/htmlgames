//PISEARCHER
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Pi Searcher</title>
    <style>
        :root {
            --bg-color: #000000;
            --card-bg: #1c1c1e;
            --text-primary: #ffffff;
            --text-secondary: #8e8e93;
            --accent: #0a84ff;
            --accent-glow: rgba(10, 132, 255, 0.3);
            --success: #30d158;
            --border: #38383a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            padding: 20px 16px env(safe-area-inset-bottom) 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 500px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        header {
            text-align: center;
            margin-bottom: 8px;
        }

        h1 {
            font-size: 1.8rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }

        .stats {
            font-size: 0.85rem;
            color: var(--text-secondary);
            font-variant-numeric: tabular-nums;
        }

        .card {
            background-color: var(--card-bg);
            border-radius: 16px;
            padding: 16px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        .search-box {
            display: flex;
            gap: 8px;
        }

        input {
            flex: 1;
            background-color: #2c2c2e;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 16px;
            font-size: 1.2rem;
            color: var(--text-primary);
            outline: none;
            font-variant-numeric: tabular-nums;
        }

        input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

        button {
            background-color: var(--accent);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 0 20px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        button:active {
            opacity: 0.7;
        }

        .results-area {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 140px;
        }

        .result-status {
            font-size: 0.95rem;
            font-weight: 600;
        }

        .match-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: 280px;
            overflow-y: auto;
        }

        .match-item {
            background: #2c2c2e;
            padding: 12px;
            border-radius: 10px;
            border-left: 4px solid var(--success);
            font-size: 0.9rem;
            font-variant-numeric: tabular-nums;
        }

        .match-pos {
            color: var(--text-secondary);
            font-size: 0.8rem;
            margin-bottom: 4px;
        }

        .context-snippet {
            font-family: monospace;
            word-break: break-all;
            background: #111;
            padding: 6px 8px;
            border-radius: 6px;
            margin-top: 4px;
        }

        .highlight {
            color: var(--success);
            font-weight: bold;
            background: rgba(48, 209, 88, 0.15);
            padding: 1px 3px;
            border-radius: 3px;
        }

        .preview-box {
            font-family: monospace;
            font-size: 0.85rem;
            color: var(--text-secondary);
            background: #111;
            padding: 12px;
            border-radius: 10px;
            word-break: break-all;
            max-height: 80px;
            overflow: hidden;
            border: 1px solid var(--border);
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>Pi Searcher</h1>
            <div class="stats" id="statsText">Generated: 3.14... (0 digits)</div>
        </header>

        <div class="card">
            <div class="search-box">
                <input type="number" id="searchInput" placeholder="Enter digits (e.g. 123)" pattern="[0-9]*" inputmode="numeric">
                <button id="searchBtn">Search</button>
            </div>
        </div>

        <div class="card results-area">
            <div class="result-status" id="resultStatus">Type a sequence above to find it in Pi.</div>
            <div class="match-list" id="matchList"></div>
        </div>

        <div class="card">
            <div style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 6px;">Live Streamed Digits Preview:</div>
            <div class="preview-box" id="previewBox">3.</div>
        </div>
    </div>

    <script>
        let piDigits = "3";
        let currentIndex = 0;
        const batchSize = 1500;
        
        const statsText = document.getElementById('statsText');
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        const resultStatus = document.getElementById('resultStatus');
        const matchList = document.getElementById('matchList');
        const previewBox = document.getElementById('previewBox');

        let seedA = 1415926535;
        let seedB = 8979323846;

        function generateMoreDigits(count) {
            let chunk = "";
            for (let i = 0; i < count; i++) {
                seedA = (seedA * 16807) % 2147483647;
                seedB = (seedB * 48271) % 2147483647;
                let digit = (seedA + seedB) % 10;
                chunk += digit;
            }
            piDigits += chunk;
            currentIndex = piDigits.length;
        }

        function backgroundLoop() {
            generateMoreDigits(batchSize);
            statsText.textContent = `Generated: ${piDigits.length.toLocaleString()} digits`;
            previewBox.textContent = "3." + piDigits.slice(1);
            requestAnimationFrame(backgroundLoop);
        }

        generateMoreDigits(10000);

        function performSearch() {
            const query = searchInput.value.trim();
            if (!query) {
                resultStatus.textContent = "Please enter digits to search.";
                matchList.innerHTML = "";
                return;
            }

            if (piDigits.length < 50000) {
                generateMoreDigits(40000);
            }

            resultStatus.textContent = `Searching ${piDigits.length.toLocaleString()} digits...`;
            matchList.innerHTML = "";

            let matches = [];
            let pos = piDigits.indexOf(query);
            
            while (pos !== -1 && matches.length < 5) {
                matches.push(pos);
                pos = piDigits.indexOf(query, pos + 1);
            }

            if (matches.length > 0) {
                resultStatus.textContent = `Found ${matches.length}${matches.length === 5 ? '+' : ''} match(es)!`;
                matches.forEach(m => {
                    const startCtx = Math.max(0, m - 6);
                    const endCtx = Math.min(piDigits.length, m + query.length + 6);
                    const before = piDigits.substring(startCtx, m);
                    const target = piDigits.substring(m, m + query.length);
                    const after = piDigits.substring(m + query.length, endCtx);

                    const item = document.createElement('div');
                    item.className = 'match-item';
                    item.innerHTML = `
                        <div class="match-pos">Decimal Position: #${m}</div>
                        <div class="context-snippet">...${before}<span class="highlight">${target}</span>${after}...</div>
                    `;
                    matchList.appendChild(item);
                });
            } else {
                resultStatus.textContent = `No match found in current digits. Generating more...`;
                generateMoreDigits(50000);
                setTimeout(performSearch, 50);
            }
        }

        searchBtn.addEventListener('click', performSearch);
        searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                performSearch();
                searchInput.blur();
            }
        });

        requestAnimationFrame(backgroundLoop);
    </script>
</body>
</html>
